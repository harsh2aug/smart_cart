{
  // Format every file with Prettier when you save
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,

  // Fix ESLint problems that can be fixed automatically when you save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // schema.prisma is formatted by the Prisma extension
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },

  // Same line endings and whitespace in every file
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Tailwind: understand Tailwind syntax in CSS files
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // Do not show build and generated files in search results
  "search.exclude": {
    "**/dist": true,
    "**/generated": true,
    "**/package-lock.json": true
  }
}
