# Copy this file to .env and fill in your own values
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/smart_cart?schema=public"
PORT=5000

# Secret used to sign login tokens. Make a long random one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Frontend address (for CORS)
CLIENT_URL="http://localhost:5173"

# Email (Brevo). Leave BREVO_API_KEY empty in development: emails are printed in the terminal.
# Required in production. MAIL_FROM_EMAIL must be a sender verified in your Brevo account.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="SmartCart"
