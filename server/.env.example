# Copy this file to .env and fill in your own values
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/smart_cart?schema=public"
PORT=5000

# Secret used to sign login tokens. Make a long random one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Frontend address (for CORS)
CLIENT_URL="http://localhost:5173"
