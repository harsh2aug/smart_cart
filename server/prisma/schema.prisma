// SmartCart database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm" // generated code uses import/export
  importFileExtension = "ts" // lets Node run the generated .ts files directly
}

// The database URL comes from DATABASE_URL in .env (see prisma7.config.ts)
datasource db {
  provider = "postgresql"
}

// A food-cart owner who uses SmartCart
model Merchant {
  id              String   @id @default(uuid()) @db.Uuid
  businessName    String   @db.VarChar(100)
  ownerName       String   @db.VarChar(100)
  phone           String   @unique @db.VarChar(15) // used to log in
  email           String   @unique @db.VarChar(255) // required: OTPs and password reset go here
  isEmailVerified Boolean  @default(false) // true after the merchant enters the email OTP
  passwordHash    String // never store the real password
  slug            String   @unique @db.VarChar(120) // public menu link, e.g. /m/raju-chaat
  description     String?
  address         String?  @db.VarChar(255) // where the cart usually stands, e.g. "Opp. City Mall"
  city            String?  @db.VarChar(100)
  isOpen          Boolean  @default(false) // cart open/closed right now
  isActive        Boolean  @default(true) // false = account suspended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories Category[]
  products   Product[]
  emailOtps  EmailOtp[]

  @@map("merchants")
}

// Why an OTP was sent
enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A one-time code sent by email. Only one per merchant per purpose:
// asking for a new code replaces the old one.
model EmailOtp {
  id         String     @id @default(uuid()) @db.Uuid
  merchantId String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String // hashed like a password, never the real code
  expiresAt  DateTime
  attempts   Int        @default(0) // wrong tries so far
  sentAt     DateTime   @default(now()) // used to stop "resend" spam

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, purpose])
  @@map("email_otps")
}

// A menu section, e.g. "Chaat" or "Drinks"
model Category {
  id           String   @id @default(uuid()) @db.Uuid
  merchantId   String   @db.Uuid
  name         String   @db.VarChar(80)
  displayOrder Int      @default(0) // lower number shows first
  isActive     Boolean  @default(true) // false = removed from the menu
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  products Product[]

  @@index([merchantId])
  @@map("categories")
}

// One item on the menu, e.g. "Pani Puri"
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  price       Decimal  @db.Decimal(10, 2) // money: never use Float
  imageUrl    String?
  isAvailable Boolean  @default(true) // false = sold out for now
  isActive    Boolean  @default(true) // false = removed from the menu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([merchantId])
  @@index([categoryId])
  @@map("products")
}
